<Application x:Class="CursorBubble.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The app's colours, metrics and control templates. Application
                 resources are the last lookup step for every window, so all
                 three pick these up without declaring anything themselves.

                 The overlay does not: it draws its own geometry from the user's
                 StyleConfig, which is a different visual language on purpose —
                 glass over the desktop rather than chrome. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Glass.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
