<Application x:Class="CursorBubble.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Shared keyboard focus ring. Application resources are the last lookup
             step for every window, so all three pick this up.

             WPF draws a FocusVisualStyle only when the keyboard was the most
             recent input device, so clicking a button with the mouse still shows
             nothing. The stock adorner is a 1px black dotted rectangle, which is
             invisible on this app's dark chrome and on the glass. -->
        <Style x:Key="FocusRing" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2"
                                   RadiusX="7" RadiusY="7"
                                   Stroke="#7FB0FF" StrokeThickness="2"
                                   SnapsToDevicePixels="True"
                                   IsHitTestVisible="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
