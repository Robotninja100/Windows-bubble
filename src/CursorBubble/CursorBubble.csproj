<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CursorBubble</RootNamespace>
    <AssemblyName>CursorBubble</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- WFAC010 tells WinForms apps to move high-DPI settings out of the
         manifest. This is a WPF app (WinForms is only used for the tray icon),
         so the manifest is the right place for them. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- Shown in the file properties of the built exe, and by Windows in the
       "unknown publisher" prompt. Version is overridden by the release
       workflow from the git tag; 0.0.0-dev marks a local or CI build. -->
  <PropertyGroup>
    <Product>CursorBubble</Product>
    <AssemblyTitle>CursorBubble</AssemblyTitle>
    <Description>Radial glass shortcut menu around the mouse cursor.</Description>
    <Company>Robotninja100</Company>
    <Authors>Robotninja100</Authors>
    <Copyright>Copyright © 2026 Robotninja100</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Robotninja100/Windows-bubble</RepositoryUrl>
    <Version>0.0.0</Version>
    <InformationalVersion>0.0.0-dev</InformationalVersion>
  </PropertyGroup>

  <!-- Static analysis. The warning set is clean, so warnings are errors: that is
       what keeps it clean. Anything genuinely not worth fixing is silenced in
       .editorconfig with a reason next to it, not left to accumulate. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The test project reaches the pure logic (geometry, parsing, storage)
       without making it public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CursorBubble.Tests" />
  </ItemGroup>

  <!-- Bundle the icon as a WPF resource so windows and the tray can load it
       via pack:// at runtime (the exe icon comes from ApplicationIcon above). -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- WPF + WinForms (NotifyIcon tray) are both enabled above; no external
       packages required. System.Text.Json ships in-box on net8.0.

       Enabling WinForms adds global usings for System.Windows.Forms and
       System.Drawing, which collide with WPF types (Color, Point, Brush,
       Application, ...) across the UI code. Remove those two global usings so
       only Tray/TrayIcon.cs imports WinForms explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
