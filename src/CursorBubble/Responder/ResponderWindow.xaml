<Window x:Class="CursorBubble.Responder.ResponderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Code"
        PreviewKeyDown="Window_PreviewKeyDown"
        Width="760" Height="520"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#1B1F27"
        Icon="pack://application:,,,/CursorBubble;component/Assets/app.ico"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelText" Color="#EAEEF6" />
        <SolidColorBrush x:Key="SubText" Color="#9AA4B4" />
        <SolidColorBrush x:Key="CardBg" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelText}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#2A0E1116" />
            <Setter Property="Foreground" Value="{StaticResource PanelText}" />
            <Setter Property="CaretBrush" Value="{StaticResource PanelText}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource PanelText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="#1EFFFFFF"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <!-- RecognizesAccessKey defaults to false on a bare
                                 ContentPresenter, which would render "_Save" with a
                                 literal underscore instead of a mnemonic. -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7FB0FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- SessionsList is the only ListBox in this window, so binding the item
             name here is safe. Without it a screen reader reads the four
             TextBlocks of the item template as run-together fragments. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
            <Setter Property="Foreground" Value="{StaticResource PanelText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="8,7" Margin="0,0,0,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333C8DFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: list of pending sessions -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button x:Name="RefreshBtn" Content="⟳" DockPanel.Dock="Right" Padding="10,4"
                        Margin="0" Click="RefreshBtn_Click"
                        ToolTip="Refresh (F5)"
                        AutomationProperties.Name="Refresh the session list" />
                <TextBlock x:Name="SessionsCaption" Text="Pending sessions" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
            <ListBox x:Name="SessionsList" Background="#22101317" BorderBrush="{StaticResource CardBorder}"
                     AutomationProperties.LabeledBy="{Binding ElementName=SessionsCaption}"
                     BorderThickness="1" SelectionChanged="SessionsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding WhenLocal}" DockPanel.Dock="Right"
                                           Foreground="{StaticResource SubText}" FontSize="11" />
                                <TextBlock Text="{Binding DisplayProject}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Accent}" FontSize="11" />
                            <TextBlock Text="{Binding Snippet}" Foreground="{StaticResource SubText}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right: detail + reply -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="EmptyHint" Text="No pending sessions." Foreground="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock x:Name="ProjectHeader" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="MetaText" Foreground="{StaticResource SubText}" FontSize="11" />
                </StackPanel>

                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="ReplyCaption" Text="Your reply" Foreground="{StaticResource SubText}"
                               FontSize="12" Margin="0,0,0,3" />
                    <!-- No IsDefault on Send: this box takes Enter as a newline.
                         Ctrl+Enter sends instead, handled in the code-behind. -->
                    <TextBox Grid.Row="1" x:Name="ReplyBox" Height="72" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             ToolTip="Ctrl+Enter sends"
                             AutomationProperties.LabeledBy="{Binding ElementName=ReplyCaption}"
                             PreviewKeyDown="ReplyBox_PreviewKeyDown" />
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource SubText}"
                                   AutomationProperties.LiveSetting="Polite"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <!-- No IsCancel on Dismiss: it deletes the session, so Escape
                                 must not be able to trigger it by reflex. -->
                            <Button x:Name="DismissBtn" Content="_Dismiss" Click="DismissBtn_Click" Margin="0"
                                    AutomationProperties.Name="Dismiss this session" />
                            <Button x:Name="SendBtn" Content="_Send ↵" Click="SendBtn_Click"
                                    Background="{StaticResource Accent}" Foreground="White"
                                    AutomationProperties.Name="Send reply" />
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Message / context fills the remaining space -->
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,0">
                    <TextBox x:Name="MessageBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="Message from Claude Code"
                             Foreground="{StaticResource PanelText}" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="10" />
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
