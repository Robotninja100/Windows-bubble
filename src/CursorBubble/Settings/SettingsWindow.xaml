<Window x:Class="CursorBubble.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorBubble Settings"
        Width="760" Height="560"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#1B1F27"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelText" Color="#EAEEF6" />
        <SolidColorBrush x:Key="SubText" Color="#9AA4B4" />
        <SolidColorBrush x:Key="CardBg" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelText}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Heading">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PanelText}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource SubText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource PanelText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="#1EFFFFFF"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <!-- RecognizesAccessKey defaults to false on a bare
                                 ContentPresenter, which would render "_Save" with a
                                 literal underscore instead of a mnemonic. -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7FB0FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#11FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#2A0E1116" />
            <Setter Property="Foreground" Value="{StaticResource PanelText}" />
            <Setter Property="CaretBrush" Value="{StaticResource PanelText}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="{StaticResource PanelText}" />
        </Style>

        <!-- These two have no other styling here; the setter exists purely so the
             keyboard focus ring is visible against the dark chrome. -->
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="{StaticResource PanelText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333C8DFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Background="#14FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="CursorBubble" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource PanelText}" Margin="16,0,16,16" />
                <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                         SelectedIndex="0" SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="General" Padding="16,10" />
                    <ListBoxItem Content="Layout" Padding="16,10" />
                    <ListBoxItem Content="Segments" Padding="16,10" />
                    <ListBoxItem Content="Style" Padding="16,10" />
                    <ListBoxItem Content="AI" Padding="16,10" />
                    <ListBoxItem Content="Claude Code" Padding="16,10" />
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Right side: content + preview + buttons -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Panels -->
            <Grid Grid.Row="0">
                <!-- General -->
                <StackPanel x:Name="PanelGeneral">
                    <TextBlock Text="General" Style="{StaticResource Heading}" />
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"
                              Margin="0,4,0,14" />
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="How to use it" FontWeight="SemiBold"
                                       Foreground="{StaticResource PanelText}" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubText}">
                                Hold the <Run FontWeight="Bold">right mouse button</Run> and then
                                <Run FontWeight="Bold">click left</Run>. The bubble appears around
                                your cursor. Move to a segment and release the mouse button to run
                                that action. Releasing in the centre (Cancel) closes the bubble
                                without doing anything.
                            </TextBlock>
                            <TextBlock x:Name="ConfigPathText" TextWrapping="Wrap"
                                       Foreground="#6B7486" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Layout -->
                <StackPanel x:Name="PanelLayout" Visibility="Collapsed">
                    <TextBlock Text="Layout" Style="{StaticResource Heading}" />

                    <DockPanel>
                        <TextBlock x:Name="OuterRadiusValue" DockPanel.Dock="Right"
                                   Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                        <TextBlock Text="Radius (outer)" Style="{StaticResource FieldLabel}" Margin="0,0,0,0" />
                    </DockPanel>
                    <Slider x:Name="OuterRadiusSlider" Minimum="80" Maximum="320" />

                    <DockPanel>
                        <TextBlock x:Name="InnerRadiusValue" DockPanel.Dock="Right"
                                   Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                        <TextBlock Text="Radius (inner)" Style="{StaticResource FieldLabel}" />
                    </DockPanel>
                    <Slider x:Name="InnerRadiusSlider" Minimum="0" Maximum="220" />

                    <DockPanel>
                        <TextBlock x:Name="StartAngleValue" DockPanel.Dock="Right"
                                   Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                        <TextBlock Text="Start angle" Style="{StaticResource FieldLabel}" />
                    </DockPanel>
                    <Slider x:Name="StartAngleSlider" Minimum="0" Maximum="360" />

                    <DockPanel>
                        <TextBlock x:Name="GapValue" DockPanel.Dock="Right"
                                   Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                        <TextBlock Text="Gap between segments" Style="{StaticResource FieldLabel}" />
                    </DockPanel>
                    <Slider x:Name="GapSlider" Minimum="0" Maximum="20" />

                    <DockPanel>
                        <TextBlock x:Name="CornerValue" DockPanel.Dock="Right"
                                   Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                        <TextBlock Text="Corner rounding" Style="{StaticResource FieldLabel}" />
                    </DockPanel>
                    <Slider x:Name="CornerSlider" Minimum="0" Maximum="60" />
                </StackPanel>

                <!-- Segments -->
                <Grid x:Name="PanelSegments" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Segments"
                               Style="{StaticResource Heading}" />

                    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="AddBtn" Content="+ Add" Margin="0,0,4,0" Click="AddBtn_Click" />
                            <Button x:Name="RemoveBtn" Content="− Remove" Click="RemoveBtn_Click" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="UpBtn" Content="▲ Up" Margin="0,0,4,0" Click="UpBtn_Click" />
                            <Button x:Name="DownBtn" Content="▼ Down" Click="DownBtn_Click" />
                        </StackPanel>
                        <ListBox x:Name="SegmentsList" DisplayMemberPath="Label" Background="#22101317"
                                 BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource PanelText}"
                                 SelectionChanged="SegmentsList_SelectionChanged" />
                    </DockPanel>

                    <StackPanel x:Name="SegmentDetail" Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LabelBox" TextChanged="Detail_Changed" />

                        <TextBlock Text="Icon" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <TextBlock x:Name="IconPreview" DockPanel.Dock="Right"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="22" Width="30" TextAlignment="Center"
                                       Foreground="{StaticResource PanelText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="IconGlyphBox" SelectionChanged="IconGlyphBox_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="16" Width="24" TextAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <TextBlock Text="Action" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ActionBox" SelectionChanged="ActionBox_Changed" />

                        <TextBlock Text="Target (path, folder, URL or command)" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button x:Name="BrowseTargetBtn" Content="Browse…" DockPanel.Dock="Right"
                                    Click="BrowseTargetBtn_Click" />
                            <TextBox x:Name="TargetBox" TextChanged="Detail_Changed" />
                        </DockPanel>
                        <Button x:Name="AiGenerateBtn" Content="✨ Generate script with AI…"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Click="AiGenerateBtn_Click" />

                        <TextBlock Text="Arguments (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ArgumentsBox" TextChanged="Detail_Changed" />

                        <TextBlock Text="Icon image (optional)" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button x:Name="BrowseIconBtn" Content="Browse…" DockPanel.Dock="Right"
                                    Click="BrowseIconBtn_Click" />
                            <TextBox x:Name="IconBox" TextChanged="Detail_Changed" />
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <!-- Style -->
                <StackPanel x:Name="PanelStyle" Visibility="Collapsed">
                    <TextBlock Text="Style" Style="{StaticResource Heading}" />

                    <CheckBox x:Name="AcrylicCheck" Content="Glass blur (acrylic)"
                              Margin="0,0,0,6" Checked="Acrylic_Changed" Unchecked="Acrylic_Changed" />

                    <CheckBox x:Name="AnimateCheck" Content="Animations (open + hover)"
                              Margin="0,0,0,6" Checked="Animate_Changed" Unchecked="Animate_Changed" />

                    <DockPanel>
                        <TextBlock x:Name="TintOpacityValue" DockPanel.Dock="Right"
                                   Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                        <TextBlock Text="Glass opacity" Style="{StaticResource FieldLabel}" />
                    </DockPanel>
                    <Slider x:Name="TintOpacitySlider" Minimum="0" Maximum="1" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Glass colour" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Border x:Name="TintSwatch" Width="22" Height="22" DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="4" Margin="4,0,0,0" />
                                <TextBox x:Name="TintColorBox" TextChanged="Color_Changed" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="3,0,3,0">
                            <TextBlock Text="Accent colour" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Border x:Name="HighlightSwatch" Width="22" Height="22" DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="4" Margin="4,0,0,0" />
                                <TextBox x:Name="HighlightColorBox" TextChanged="Color_Changed" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="Text colour" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Border x:Name="LabelSwatch" Width="22" Height="22" DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="4" Margin="4,0,0,0" />
                                <TextBox x:Name="LabelColorBox" TextChanged="Color_Changed" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- AI -->
                <StackPanel x:Name="PanelAi" Visibility="Collapsed">
                    <TextBlock Text="AI script generator" Style="{StaticResource Heading}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubText}" Margin="0,0,0,10">
                        Have Claude write a PowerShell script for you from a description. This needs
                        your own Anthropic API key. The generated script is always shown first so you
                        can read it before it is saved.
                    </TextBlock>

                    <TextBlock Text="API key" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="AiApiKeyBox" Padding="6,4" Background="#2A0E1116"
                                 Foreground="{StaticResource PanelText}" BorderBrush="{StaticResource CardBorder}"
                                 PasswordChanged="AiApiKey_Changed" />

                    <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="AiModelBox" SelectionChanged="AiModel_Changed" />

                    <TextBlock TextWrapping="Wrap" Foreground="#6B7486" FontSize="11" Margin="0,10,0,0">
                        Create a key at console.anthropic.com. It is stored encrypted in config.json
                        (Windows DPAPI, readable only by your account).
                    </TextBlock>
                </StackPanel>

                <!-- Claude Code -->
                <StackPanel x:Name="PanelClaude" Visibility="Collapsed">
                    <TextBlock Text="Claude Code inbox" Style="{StaticResource Heading}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubText}" Margin="0,0,0,10">
                        See your Claude Code sessions (in VS Code or a terminal) in the bubble as soon
                        as they stop or have a question, and answer them from a glass window. Link
                        CursorBubble to Claude Code for this — that adds hooks to your
                        ~/.claude/settings.json. Give a segment the “Open Claude Code inbox” action.
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="LinkClaudeBtn" Content="Link Claude Code" Margin="0"
                                Background="#4C8DFF" Foreground="White" Click="LinkClaude_Click" />
                        <Button x:Name="UnlinkClaudeBtn" Content="Unlink" Click="UnlinkClaude_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ClaudeStatusText" Foreground="{StaticResource SubText}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap" Foreground="#6B7486" FontSize="11" Margin="0,10,0,0">
                        Replies are delivered to the right window through the clipboard (focus → paste
                        → Enter). Restart any running Claude Code sessions after linking so the hooks
                        take effect.
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Live preview -->
            <Border Grid.Row="1" Margin="0,16,0,0" Height="170" CornerRadius="10"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <!-- Light backdrop: the glass is designed to sit on a desktop
                     wallpaper, so a dark preview would misrepresent it. -->
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D8E1EC" Offset="0" />
                        <GradientStop Color="#8CA0B8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="Live Preview" Foreground="#33404F" FontSize="11"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,6,0,0" />
                    <Viewbox x:Name="PreviewBox" Margin="10,20,10,10" Stretch="Uniform" />
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelBtn" Content="Cancel" Click="CancelBtn_Click" />
                <Button x:Name="SaveBtn" Content="Save" Foreground="White" Click="SaveBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="6" Background="{StaticResource Accent}"
                                    BorderBrush="#5C9BFF" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="12,6" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#DCE9FF" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#5C9BFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3F7AE0" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
