<Window x:Class="CursorBubble.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:CursorBubble.Controls"
        Title="CursorBubble"
        Width="1000" Height="720"
        MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Icon="pack://application:,,,/CursorBubble;component/Assets/app.ico"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing">

    <!-- All styling comes from Themes/Glass.xaml via App.xaml. What is declared
         here is only what is specific to this window: the shape of one row in
         one of its lists. -->
    <Window.Resources>

        <!-- Sidebar entry: icon, then the page name. -->
        <DataTemplate x:Key="NavItemTemplate">
            <DockPanel>
                <ctl:DecorativeTextBlock DockPanel.Dock="Left" Text="{Binding Glyph}"
                                         Style="{StaticResource Icon}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- One number on the Overview page. -->
        <DataTemplate x:Key="StatTileTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14,12">
                <StackPanel>
                    <DockPanel>
                        <ctl:DecorativeTextBlock DockPanel.Dock="Right" Text="{Binding Glyph}"
                                                 Style="{StaticResource AccentIcon}"
                                                 VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource StatCaption}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource StatDetail}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One sentence about how the app is being used. -->
        <DataTemplate x:Key="FactTemplate">
            <DockPanel Margin="0,0,0,10">
                <ctl:DecorativeTextBlock DockPanel.Dock="Left" Text="{Binding Glyph}"
                                         Style="{StaticResource AccentIcon}"
                                         VerticalAlignment="Top" Margin="0,1,8,0" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           Foreground="{StaticResource SubText}" FontSize="12" />
            </DockPanel>
        </DataTemplate>

        <!-- One bar in the "most used" chart. The bar's track is a fixed width
             because the filled part is measured in pixels in code: a star-sized
             column would make the two disagree the moment the window is resized. -->
        <DataTemplate x:Key="SegmentBarTemplate">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,0,10,0" />
                <Border Grid.Column="1" Width="180" Height="8" CornerRadius="4"
                        Background="{StaticResource TrackBg}" VerticalAlignment="Center">
                    <Border Width="{Binding BarWidth}" HorizontalAlignment="Left"
                            CornerRadius="4" Background="{StaticResource Accent}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" MinWidth="52"
                           TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource SubText}" FontSize="11" />
            </Grid>
        </DataTemplate>

        <!-- A group of settings, as a row that takes you there. -->
        <DataTemplate x:Key="TuningAreaTemplate">
            <Button Style="{StaticResource RowButton}" Click="TuningArea_Click"
                    AutomationProperties.Name="{Binding NavigateHint}">
                <DockPanel>
                    <ctl:DecorativeTextBlock DockPanel.Dock="Left" Text="{Binding Glyph}"
                                             Style="{StaticResource AccentIcon}"
                                             VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                               Foreground="{StaticResource SubText}" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource StatDetail}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==== Sidebar ==================================================== -->
        <Border Grid.Column="0" Background="{StaticResource NavBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,14">

                <!-- Identity. The icon is drawn as a Border's background rather
                     than an Image so it stays out of the automation tree: it
                     repeats the name beside it. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,16,18">
                    <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusCard}">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/CursorBubble;component/Assets/app.ico"
                                        Stretch="Uniform" />
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CursorBubble" FontWeight="Bold" FontSize="14" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource StatCaption}" />
                    </StackPanel>
                </StackPanel>

                <!-- A glance at the counters, on every page. -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                        Margin="12,14,12,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="RailStatValue" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource PanelText}" />
                        <TextBlock x:Name="RailStatCaption" Style="{StaticResource StatDetail}" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                         Margin="8,0,8,0" Padding="0"
                         AutomationProperties.Name="Settings sections"
                         ItemTemplate="{StaticResource NavItemTemplate}"
                         SelectedIndex="0" SelectionChanged="NavList_SelectionChanged" />
            </DockPanel>
        </Border>

        <!-- ==== Content ==================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page header: which page you are on, and what it is for. -->
            <StackPanel Grid.Row="0" Margin="24,20,24,14">
                <TextBlock Text="{Binding SelectedItem.Title, ElementName=NavList}"
                           Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding SelectedItem.Subtitle, ElementName=NavList}"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,0,18,4" Focusable="False">
                <Grid>

                    <!-- ==== Overview ==== -->
                    <StackPanel x:Name="PanelOverview">
                        <!-- Negative right margin: each tile carries its own
                             gutter, and the last column's would otherwise push
                             the row in from the edge the rest of the page uses. -->
                        <ItemsControl x:Name="StatTiles" Margin="0,0,-10,0"
                                      AutomationProperties.Name="Usage summary"
                                      ItemTemplate="{StaticResource StatTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="What you actually use" Style="{StaticResource CardTitle}" />
                                    <ItemsControl x:Name="SegmentBars"
                                                  AutomationProperties.Name="Most used segments"
                                                  ItemTemplate="{StaticResource SegmentBarTemplate}" />
                                    <TextBlock x:Name="SegmentBarsEmpty" Style="{StaticResource StatDetail}"
                                               Text="No segment has been run yet. As soon as one is, this becomes a ranking." />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Did you know" Style="{StaticResource CardTitle}" />
                                    <ItemsControl x:Name="FactList"
                                                  AutomationProperties.Name="Facts about your use"
                                                  ItemTemplate="{StaticResource FactTemplate}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TunablesTitle" Style="{StaticResource CardTitle}" />
                                <ItemsControl x:Name="TuningAreaList"
                                              ItemTemplate="{StaticResource TuningAreaTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==== General ==== -->
                    <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Startup" Style="{StaticResource CardTitle}" />
                                <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"
                                          Checked="Startup_Changed" Unchecked="Startup_Changed" />
                                <TextBlock Style="{StaticResource HintLabel}" Margin="0,8,0,0"
                                           Text="CursorBubble sits in the notification area and waits for the gesture. It has no window of its own." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="The shortcut" Style="{StaticResource CardTitle}" />
                                <!-- The caption reads as a full label on purpose:
                                     a screen reader announces it in place of the
                                     card title, which it never sees. -->
                                <TextBlock x:Name="HotkeyCaption" Text="Keyboard shortcut for the bubble"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                <DockPanel>
                                    <Button x:Name="HotkeyResetBtn" Content="_Reset" DockPanel.Dock="Right"
                                            Click="HotkeyResetBtn_Click"
                                            AutomationProperties.Name="Reset the keyboard shortcut to Ctrl+Alt+Space" />
                                    <!-- Read-only: the value is captured from the keys pressed,
                                         not typed. Focus it and press the combination. -->
                                    <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                             ToolTip="Click here, then press the combination you want"
                                             AutomationProperties.LabeledBy="{Binding ElementName=HotkeyCaption}"
                                             AutomationProperties.HelpText="Press the key combination you want. Tab moves on without changing it." />
                                </DockPanel>
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource HintLabel}"
                                           Margin="0,8,0,0"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Counting" Style="{StaticResource CardTitle}" />
                                <CheckBox x:Name="CollectStatsCheck" Content="Count how often I use the bubble"
                                          Checked="CollectStats_Changed" Unchecked="CollectStats_Changed" />
                                <TextBlock Style="{StaticResource HintLabel}" Margin="0,8,0,0"
                                           Text="Fills in the Overview page. The counters are written to usage.json beside your settings, they are never sent anywhere, and About has a button that deletes them." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="How to use it" Style="{StaticResource CardTitle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubText}">
                                    Hold the <Run FontWeight="Bold">right mouse button</Run> and then
                                    <Run FontWeight="Bold">click left</Run>. The bubble appears around
                                    your cursor. Move to a segment and release the mouse button to run
                                    that action. Releasing in the centre (Cancel) closes the bubble
                                    without doing anything.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==== Layout ==== -->
                    <StackPanel x:Name="PanelLayout" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="The ring" Style="{StaticResource CardTitle}" />

                                <DockPanel>
                                    <TextBlock x:Name="OuterRadiusValue" DockPanel.Dock="Right"
                                               Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                                    <TextBlock x:Name="OuterRadiusCaption" Text="Radius (outer)"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,0" />
                                </DockPanel>
                                <Slider x:Name="OuterRadiusSlider" Minimum="80" Maximum="320"
                                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                                        AutomationProperties.LabeledBy="{Binding ElementName=OuterRadiusCaption}" />

                                <DockPanel>
                                    <TextBlock x:Name="InnerRadiusValue" DockPanel.Dock="Right"
                                               Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                                    <TextBlock x:Name="InnerRadiusCaption" Text="Radius (inner)" Style="{StaticResource FieldLabel}" />
                                </DockPanel>
                                <Slider x:Name="InnerRadiusSlider" Minimum="0" Maximum="220"
                                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                                        AutomationProperties.LabeledBy="{Binding ElementName=InnerRadiusCaption}" />

                                <TextBlock Style="{StaticResource HintLabel}"
                                           Text="The inner circle is the cancel zone: let go there and nothing runs." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="The segments" Style="{StaticResource CardTitle}" />

                                <DockPanel>
                                    <TextBlock x:Name="StartAngleValue" DockPanel.Dock="Right"
                                               Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                                    <TextBlock x:Name="StartAngleCaption" Text="Start angle" Style="{StaticResource FieldLabel}" Margin="0,0,0,0" />
                                </DockPanel>
                                <Slider x:Name="StartAngleSlider" Minimum="0" Maximum="360"
                                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="15"
                                        AutomationProperties.LabeledBy="{Binding ElementName=StartAngleCaption}" />

                                <DockPanel>
                                    <TextBlock x:Name="GapValue" DockPanel.Dock="Right"
                                               Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                                    <TextBlock x:Name="GapCaption" Text="Gap between segments" Style="{StaticResource FieldLabel}" />
                                </DockPanel>
                                <Slider x:Name="GapSlider" Minimum="0" Maximum="20"
                                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                                        AutomationProperties.LabeledBy="{Binding ElementName=GapCaption}" />

                                <DockPanel>
                                    <TextBlock x:Name="CornerValue" DockPanel.Dock="Right"
                                               Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                                    <TextBlock x:Name="CornerCaption" Text="Corner rounding" Style="{StaticResource FieldLabel}" />
                                </DockPanel>
                                <Slider x:Name="CornerSlider" Minimum="0" Maximum="60"
                                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                                        AutomationProperties.LabeledBy="{Binding ElementName=CornerCaption}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==== Segments ==== -->
                    <Grid x:Name="PanelSegments" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="236" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="AddBtn" Content="+ _Add" Margin="0,0,4,0" Click="AddBtn_Click"
                                        AutomationProperties.Name="Add segment" />
                                <Button x:Name="RemoveBtn" Content="− _Remove" Click="RemoveBtn_Click"
                                        AutomationProperties.Name="Remove the selected segment" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="UpBtn" Content="▲ _Up" Margin="0,0,4,0" Click="UpBtn_Click"
                                        AutomationProperties.Name="Move the selected segment up" />
                                <Button x:Name="DownBtn" Content="▼ _Down" Click="DownBtn_Click"
                                        AutomationProperties.Name="Move the selected segment down" />
                            </StackPanel>
                            <!-- A fixed height rather than a starred row: this page
                                 lives inside a scroll viewer, which offers a child
                                 all the height it asks for. -->
                            <ListBox x:Name="SegmentsList" DisplayMemberPath="Label" Height="330"
                                     AutomationProperties.Name="Segments"
                                     SelectionChanged="SegmentsList_SelectionChanged" />
                        </DockPanel>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,4,14,14">
                            <StackPanel x:Name="SegmentDetail">
                                <TextBlock x:Name="LabelCaption" Text="Name" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LabelBox" TextChanged="Detail_Changed"
                                         AutomationProperties.LabeledBy="{Binding ElementName=LabelCaption}" />

                                <TextBlock x:Name="IconCaption" Text="Icon" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <!-- Decorative: this renders a private-use-area codepoint,
                                         which a screen reader would read out as garbage in front
                                         of the combo box that actually names the icon. -->
                                    <ctl:DecorativeTextBlock x:Name="IconPreview" DockPanel.Dock="Right"
                                                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                             FontSize="22" Width="30" TextAlignment="Center"
                                                             Foreground="{StaticResource PanelText}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="IconGlyphBox" SelectionChanged="IconGlyphBox_Changed"
                                              AutomationProperties.LabeledBy="{Binding ElementName=IconCaption}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}"
                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="16" Width="24" TextAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>

                                <TextBlock x:Name="ActionCaption" Text="Action" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ActionBox" SelectionChanged="ActionBox_Changed"
                                          AutomationProperties.LabeledBy="{Binding ElementName=ActionCaption}" />

                                <TextBlock x:Name="TargetCaption" Text="Target (path, folder, URL or command)"
                                           Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <!-- Two buttons in this panel read "Browse…"; only an explicit
                                         name tells them apart when they are read out of context. -->
                                    <Button x:Name="BrowseTargetBtn" Content="Browse…" DockPanel.Dock="Right"
                                            Click="BrowseTargetBtn_Click"
                                            AutomationProperties.Name="Browse for a target file" />
                                    <TextBox x:Name="TargetBox" TextChanged="Detail_Changed"
                                             AutomationProperties.LabeledBy="{Binding ElementName=TargetCaption}" />
                                </DockPanel>
                                <Button x:Name="AiGenerateBtn" Content="✨ _Generate script with AI…"
                                        HorizontalAlignment="Left" Margin="0,6,0,0" Click="AiGenerateBtn_Click"
                                        AutomationProperties.Name="Generate a script with AI" />

                                <TextBlock x:Name="ArgumentsCaption" Text="Arguments (optional)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ArgumentsBox" TextChanged="Detail_Changed"
                                         AutomationProperties.LabeledBy="{Binding ElementName=ArgumentsCaption}" />
                                <TextBlock x:Name="ArgumentsHint" Visibility="Collapsed"
                                           Foreground="{StaticResource WarnText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="The target is an inline command, so it already contains its own arguments — this field is ignored. Point at a .ps1, .bat or .cmd file to use it." />

                                <TextBlock x:Name="IconImageCaption" Text="Icon image (optional)" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button x:Name="BrowseIconBtn" Content="Browse…" DockPanel.Dock="Right"
                                            Click="BrowseIconBtn_Click"
                                            AutomationProperties.Name="Browse for an icon image" />
                                    <TextBox x:Name="IconBox" TextChanged="Detail_Changed"
                                             AutomationProperties.LabeledBy="{Binding ElementName=IconImageCaption}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ==== Style ==== -->
                    <StackPanel x:Name="PanelStyle" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Glass" Style="{StaticResource CardTitle}" />

                                <CheckBox x:Name="AcrylicCheck" Content="Glass blur (acrylic)"
                                          Margin="0,0,0,8" Checked="Acrylic_Changed" Unchecked="Acrylic_Changed" />

                                <CheckBox x:Name="AnimateCheck" Content="Animations (open + hover)"
                                          Checked="Animate_Changed" Unchecked="Animate_Changed" />

                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="TintOpacityValue" DockPanel.Dock="Right"
                                               Foreground="{StaticResource SubText}" MinWidth="52" TextAlignment="Right" />
                                    <TextBlock x:Name="TintOpacityCaption" Text="Glass opacity" Style="{StaticResource FieldLabel}" />
                                </DockPanel>
                                <Slider x:Name="TintOpacitySlider" Minimum="0" Maximum="1"
                                        IsSnapToTickEnabled="True" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.1"
                                        AutomationProperties.LabeledBy="{Binding ElementName=TintOpacityCaption}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Colours" Style="{StaticResource CardTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock x:Name="TintColorCaption" Text="Glass colour" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                        <DockPanel>
                                            <Border x:Name="TintSwatch" Width="22" Height="22" DockPanel.Dock="Right"
                                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusControl}" Margin="4,0,0,0" />
                                            <TextBox x:Name="TintColorBox" TextChanged="Color_Changed"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=TintColorCaption}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                        <TextBlock x:Name="HighlightColorCaption" Text="Accent colour" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                        <DockPanel>
                                            <Border x:Name="HighlightSwatch" Width="22" Height="22" DockPanel.Dock="Right"
                                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusControl}" Margin="4,0,0,0" />
                                            <TextBox x:Name="HighlightColorBox" TextChanged="Color_Changed"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=HighlightColorCaption}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                        <TextBlock x:Name="LabelColorCaption" Text="Text colour" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                        <DockPanel>
                                            <Border x:Name="LabelSwatch" Width="22" Height="22" DockPanel.Dock="Right"
                                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusControl}" Margin="4,0,0,0" />
                                            <TextBox x:Name="LabelColorBox" TextChanged="Color_Changed"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=LabelColorCaption}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource HintLabel}"
                                           Text="Written as #RRGGBB. The preview below updates as you type." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==== AI ==== -->
                    <StackPanel x:Name="PanelAi" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Anthropic account" Style="{StaticResource CardTitle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubText}" Margin="0,0,0,4">
                                    Have Claude write a PowerShell script for you from a description. This needs
                                    your own Anthropic API key. The generated script is always shown first so you
                                    can read it before it is saved.
                                </TextBlock>

                                <TextBlock x:Name="AiApiKeyCaption" Text="API key" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="AiApiKeyBox"
                                             AutomationProperties.LabeledBy="{Binding ElementName=AiApiKeyCaption}"
                                             PasswordChanged="AiApiKey_Changed" />

                                <TextBlock x:Name="AiModelCaption" Text="Model" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="AiModelBox" SelectionChanged="AiModel_Changed"
                                          AutomationProperties.LabeledBy="{Binding ElementName=AiModelCaption}" />

                                <TextBlock Style="{StaticResource HintLabel}"
                                           Text="Create a key at console.anthropic.com. It is stored encrypted in config.json (Windows DPAPI, readable only by your account)." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Where the button is" Style="{StaticResource CardTitle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubText}"
                                           Text="On the Segments page: pick a segment, then “Generate script with AI…”. The script is saved next to your settings and the segment is pointed at it." />
                                <Button Content="Go to _Segments" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Click="GoToSegments_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==== Claude Code ==== -->
                    <StackPanel x:Name="PanelClaude" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Inbox" Style="{StaticResource CardTitle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubText}" Margin="0,0,0,10">
                                    See your Claude Code sessions (in VS Code or a terminal) in the bubble as soon
                                    as they stop or have a question, and answer them from a glass window. Link
                                    CursorBubble to Claude Code for this — that adds hooks to your
                                    ~/.claude/settings.json. Give a segment the “Open Claude Code inbox” action.
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="LinkClaudeBtn" Content="_Link Claude Code" Margin="0"
                                            Style="{StaticResource PrimaryButton}" Click="LinkClaude_Click" />
                                    <Button x:Name="UnlinkClaudeBtn" Content="_Unlink" Click="UnlinkClaude_Click"
                                            AutomationProperties.Name="Unlink Claude Code" />
                                </StackPanel>
                                <TextBlock x:Name="ClaudeStatusText" Foreground="{StaticResource SubText}"
                                           AutomationProperties.LiveSetting="Polite"
                                           Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource HintLabel}"
                                           Text="Replies are delivered to the right window through the clipboard (focus → paste → Enter). Restart any running Claude Code sessions after linking so the hooks take effect." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==== About ==== -->
                    <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CursorBubble" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="AboutVersionText" Foreground="{StaticResource SubText}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource HintLabel}"
                                           Text="A radial glass shortcut menu around the mouse cursor. Open source, MIT licensed." />
                                <Button Content="Open the project page" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Click="OpenRepository_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Files" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="ConfigPathText" TextWrapping="Wrap"
                                           Foreground="{StaticResource SubText}" FontSize="12" />
                                <TextBlock x:Name="StatsPathText" TextWrapping="Wrap"
                                           Foreground="{StaticResource SubText}" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock x:Name="LogPathText" TextWrapping="Wrap"
                                           Foreground="{StaticResource SubText}" FontSize="12" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Open _folder" Margin="0" Click="OpenConfigFolder_Click"
                                            AutomationProperties.Name="Open the folder your settings are stored in" />
                                    <Button Content="Open _log" Click="OpenLog_Click"
                                            AutomationProperties.Name="Open today's log file" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Usage statistics" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="ResetStatsStatus" Foreground="{StaticResource SubText}"
                                           TextWrapping="Wrap" FontSize="12"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="ResetStatsBtn" Content="_Delete my statistics"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetStats_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Live preview. Shown only on the pages that change how the bubble
                 looks; on the others it is dead weight that costs the page a
                 third of its height. -->
            <Border x:Name="PreviewCard" Grid.Row="2" Margin="24,14,24,0" Height="170"
                    CornerRadius="{StaticResource RadiusSurface}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <!-- Light backdrop: the glass is designed to sit on a desktop
                     wallpaper, so a dark preview would misrepresent it. -->
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D8E1EC" Offset="0" />
                        <GradientStop Color="#8CA0B8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="Live preview" Foreground="#33404F" FontSize="11"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,6,0,0" />
                    <Viewbox x:Name="PreviewBox" Margin="10,20,10,10" Stretch="Uniform" />
                </Grid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="3" Margin="0,14,0,0" Padding="24,12"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Escape cancels, Enter saves. Every text box on this window is
                             single-line, so Enter never has a competing meaning. -->
                        <Button x:Name="CancelBtn" Content="_Cancel" Click="CancelBtn_Click" IsCancel="True" />
                        <Button x:Name="SaveBtn" Content="_Save" Click="SaveBtn_Click" IsDefault="True"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <Border x:Name="DirtyPill" Style="{StaticResource Pill}"
                            HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock Text="Unsaved changes" FontSize="11" Foreground="{StaticResource WarnText}" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
