<Window x:Class="CursorBubble.Settings.AiScriptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate script with AI"
        Width="620" Height="600"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        Icon="pack://application:,,,/CursorBubble;component/Assets/app.ico"
        FontFamily="Segoe UI">

    <!-- All styling comes from Themes/Glass.xaml via App.xaml. -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="DescriptionCaption" Text="Describe what the script should do"
                   FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox Grid.Row="1" x:Name="DescriptionBox" Height="70"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.LabeledBy="{Binding ElementName=DescriptionCaption}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="GenerateBtn" Content="_Generate" Click="GenerateBtn_Click"
                    Style="{StaticResource PrimaryButton}" Margin="0" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource SubText}"
                       AutomationProperties.LiveSetting="Polite"
                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="3" x:Name="ResultInfo" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock Text="Explanation" FontWeight="SemiBold" Margin="0,0,0,3" />
            <TextBlock x:Name="ExplanationText" Foreground="{StaticResource SubText}" TextWrapping="Wrap" />
            <Border x:Name="WarningBox" Visibility="Collapsed" Margin="0,8,0,0"
                    Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="10">
                <!-- Assertive, not Polite: this is the safety warning about a script
                     that is about to be written to disk and later run. -->
                <TextBlock x:Name="WarningsText" Foreground="{StaticResource WarnText}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="4" x:Name="ScriptArea" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,3" x:Name="ScriptCaption"
                       Text="Script — read this before you use it:" FontWeight="SemiBold" />
            <!-- Deliberately no AcceptsTab: it swallowed Tab with no way back out,
                 which traps keyboard users in the box (WCAG 2.1.2). -->
            <TextBox x:Name="ScriptBox" FontFamily="Consolas, Cascadia Mono, Courier New"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     AutomationProperties.LabeledBy="{Binding ElementName=ScriptCaption}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </DockPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <!-- Escape cancels. Deliberately no IsDefault on "Use this": it writes a
                 script to disk, and the whole point of this dialog is to read it first. -->
            <Button x:Name="CancelBtn" Content="_Cancel" Click="CancelBtn_Click" Margin="0" IsCancel="True" />
            <Button x:Name="UseBtn" Content="_Use this" Click="UseBtn_Click"
                    IsEnabled="False" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
